# Профиль стенда RTX 2080 Ti (Turing) для Ornith-1.5-35B Q4_K_M, 2026-10-31.
# CONTEXT_LIMIT ОБЯЗАТЕЛЕН и равен CTX: дефолт 81920 молча обрезает KV;
# PREFILL_SM75 по умолчанию ON (2026-10-31), строка ниже фиксирует выбор явно
# (см. журнал docs/research/2026-10-30-turing-prefill.md §5p).

API_KEYS=[{"key":"test.key","name":"bench"}]
MODEL=/data/models/ornith/Ornith-1.5-35B-Q4_K_M.gguf
QWN36_HOST=127.0.0.1
QWEN36_HOST=127.0.0.1
QWEN36_PORT=18199
CTX=131072
SLOTS=1
GPU_ONLY=1
GPU_LAYERS=999
KV_POOL_Q8=0
PREFILL_CHUNK=512
FLASH_ATTN=0
CUDA_GRAPHS=1
PGRAPH=off
MTP=0
PREFIX_CACHE_MIB=0
F16_FAST_ACC=1
PREFILL_MIN_FREE_MIB=512
REQ_TIMEOUT=7200
VRAM_HEADROOM_MIB=1024
MOE_EXPERTS=auto
RUST_BACKTRACE=1
EXPERT_PROMOTE_PER_STEP=64
GRAPH_WINDOW=131072
EXPERT_CACHE_MIB=1500
PREFILL_SM75=0
PREFILL_NAN_TRACE=0
CONTEXT_LIMIT=131072
