# Профиль для запуска: yforge --env docs/profiles/2026-10-30-rtx2080ti-ornith9b.env
# MODEL укажите под свой путь, например:
#   MODEL=/home/ubuntu/models/Ornith-1.5-9B-Q4_K_M.gguf

# Проверенный профиль: Ornith-1.5-9B Q4_K_M на RTX 2080 Ti 11 ГиБ (sm_75)
#
# Замер 2026-10-30, тот же HTTP-запрос к llama-server:
#   prefill     2338.6 tok/s  против 2100.4 (+11.3%)
#   generation    84.7 tok/s  против   80.6 (+5.1%)
#   холодный первый запрос: 2339 против 1651
#   GPU-only время: 190.4 мс на 505 ток = 2652 tok/s против llama-bench 2513
#
# Greedy 1..18 проходит, окно KV 32768 сохранено.
# Обоснование каждого пункта и отвергнутые варианты —
# docs/research/2026-10-30-turing-prefill.md

GPU_ONLY=1
GPU_LAYERS=999

# Prefill-граф на sm75 нестабилен (дрейфует по parity), декод-граф нужен:
# без него generation падает 85 -> 76.
PGRAPH=off
CUDA_GRAPHS=1

# На sm75 нет cp.async, FA2 численно неверна — prefill-attention идёт
# ручным F32-путём. F16-вариант ломает parity даже с F32-аккумулятором.
FLASH_ATTN=0

KV_POOL_Q8=0
PREFIX_CACHE_MIB=0
MTP=0

CTX=32768
SLOTS=1
# На Turing чанк 2048; 1024/512 медленнее.
# n_batch задаётся сервером (2048).

# F16-кэш FFN: 3600 МиБ — граница, где окно 32768 ещё цело.
# Больше 3600: окно падает до 29632/11200 и ломается parity.
# Меньше — медленнее (1200 -> 2228, 2400 -> 2272, 3000 -> 2303).
YTTRI_F16_MLP_CACHE_MIB=3600

# Сквозной F16 в FFN (3 конверсии вместо 6). Без этого флага кэш ломает
# greedy-выдачу уже с 6 слоёв и prefill ниже на 2.3%.
F16_FAST_ACC=1

# Порог trim между чанками. При 512 на этом профиле trim не срабатывает
# (свободно 2240 МиБ), значение оставлено страховкой от OOM.
PREFILL_MIN_FREE_MIB=512

# MMQ_X НЕ задавать: автовыбор берёт x64 для узких матриц (n <= 2048),
# где x128 даёт 16.8 против 25.8 TFLOPS. Жёсткий MMQ_X=128 медленнее на 0.7%.

API_KEYS=[{"key":"test.key","name":"bench"}]
QWEN36_PORT=18099
QWEN36_HOST=127.0.0.1
